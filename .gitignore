# --- 依赖 ---
node_modules/

# --- 构建产物（lib/page/ 是独立页的完整静态根，由 tsdown + scripts/copy-page.mjs 生成）---
lib/
dist/
*.tsbuildinfo

# --- 分发产物（pnpm pack / npm pack）---
*.tgz

# --- IDE / 编辑器 ---
.idea/
.vscode/
*.suo
*.user

# --- 操作系统 ---
.DS_Store
Thumbs.db
desktop.ini

# --- 日志 / 临时文件 ---
*.log
npm-debug.log*
pnpm-debug.log*

# --- 密钥 / 环境变量 ---
.env
.env.*
!.env.example

# --- 测试 / 覆盖率 ---
coverage/

