{
  "name": "dsh-model-capability-enhancement",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Settings section for llm-pi-ai custom providers: per-model vision input (input), provider default reasoning level (reasoning) and per-model reasoning effort wire maps (reasoningEfforts) — fields the config supports but the Models page does not expose.",
  "main": "lib/index.mjs",
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "verify": "node --import tsx/esm src/verify/verify.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-api-remotes": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.7-rc.2",
    "antd": "^6.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.7",
    "js-yaml": "^4.1.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4"
  }
}
